[Unit]
Description=AirClipboard HTTP backend
After=network.target

[Service]
Type=simple
User=airclipboard
Group=airclipboard
WorkingDirectory=/var/lib/airclipboard
ExecStart=/opt/airclipboard/current/airclipboard --listen=127.0.0.1:18128 --allowed-origins=http://ac.enenh.com,http://103.236.77.86:32347
Environment=GIN_MODE=release
Environment=TZ=Asia/Shanghai
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airclipboard
MemoryMax=700M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
