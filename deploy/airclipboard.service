[Unit]
Description=AirClipboard HTTP backend
After=network.target

[Service]
Type=simple
User=airclipboard
Group=airclipboard
WorkingDirectory=/var/lib/airclipboard
ExecStart=/opt/airclipboard/current/airclipboard --listen=127.0.0.1:18128 --allowed-origins=https://ac.enenh.com,https://ac-api.enenh.com
Environment=GIN_MODE=release
Environment=TZ=Asia/Shanghai
Environment=GOMEMLIMIT=400MiB
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airclipboard
MemoryMax=700M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
